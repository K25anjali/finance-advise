# Which provider to use: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o

LOG_LEVEL=INFO

# ── Accounts ──────────────────────────────────────────────────────────────
# Random string used to sign OAuth state. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Database: defaults to SQLite at server/data/ledgerline.db. Use Postgres in production.
# DATABASE_URL=postgresql://user:pass@host:5432/ledgerline

# Where the browser reaches the app and the API (dev: the API sits behind Vite's /api proxy)
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api
COOKIE_SECURE=false

# Google sign-in: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorized redirect URI: http://localhost:5173/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in: github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:5173/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
